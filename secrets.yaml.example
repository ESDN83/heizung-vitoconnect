# Die zentrale secrets.yaml liegt auf dem HA-Host unter /config/esphome/secrets.yaml
# und wird von mehreren ESPHome-Geraeten geteilt. Fuer dieses Projekt werden zwei
# projektspezifische Eintraege erwartet (damit sich die Heizung nicht die Credentials
# der anderen ESPs zieht).

heizung_api_encryption_key: "DEIN_API_ENCRYPTION_KEY_HIER"
heizung_ota_password: "DEIN_OTA_PASSWORT_HIER"
